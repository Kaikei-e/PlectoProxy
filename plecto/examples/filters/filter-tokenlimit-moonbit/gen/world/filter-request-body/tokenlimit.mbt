// filter-tokenlimit-moonbit — a token-COST rate limiter for JSON generation APIs.
//
// "One request" is the wrong unit of cost for a generation endpoint: a twenty-token prompt
// and a twenty-thousand-token prompt are one request each and nothing alike on the bill. So
// this filter prices every request from its own JSON payload and spends that price against
// the host's token bucket. The bucket's capacity and refill are OPERATOR-owned, declared in
// the manifest (`[[filter]] ratelimit = { ... }`, ADR 000026) — the filter can only spend
// from it, never widen it, which is what makes the arrangement safe for a filter that is
// itself untrusted code.
//
// It exports `on-request-body` and NOT `on-response-body`. That absence is the whole design:
// pricing needs what the client ASKED for, and asking the host to buffer response bodies
// would cost every streamed answer its zero-copy path in exchange for nothing (ADR 000038 /
// ADR 000098). The host reads the absent export as "this filter never reads response bodies".
//
// Implements the `declare` stubs in top.mbt (generated by wit-bindgen).

// ---------------------------------------------------------------------------------------
// Effective configuration
// ---------------------------------------------------------------------------------------
// Resolved ONCE in `init` (Tenet 4: heavy work stays off the hot path). `host-config` is
// read-only and operator-owned, so its values cannot change under a running instance and
// re-reading them per request would buy nothing but boundary crossings.

///| Request header carrying the rate-limit key. Stored lowercased; see `find_header`.
let cfg_key_header : Ref[String] = Ref("x-api-key")

///| Output reservation assumed when the payload names no `max_tokens`.
let cfg_max_tokens_default : Ref[UInt64] = Ref(1024UL)

///| UTF-8 bytes of input per estimated token.
let cfg_chars_per_token : Ref[UInt64] = Ref(4UL)

// ---------------------------------------------------------------------------------------
// Per-request scratch
// ---------------------------------------------------------------------------------------
// `on-request` sees the headers but not the body; `on-request-body` sees the body but NOT
// the headers. The rate-limit key lives in a header and the price is computed from the body,
// so something has to carry the key across the two hooks, and the only carrier a component
// instance has is instance-global state.
//
// THE SCRATCH RULE: every field below is written unconditionally at the TOP of `on-request`,
// before any early return, and none of them is ever read before that write within a request.
// That is what keeps the filter stateless ACROSS requests even when the operator pools
// instances (`isolation = "trusted"`), where the previous request's key would otherwise
// still be sitting here waiting to be spent by someone else.

///| The key `on-request` read out of `cfg_key_header`.
let scratch_key : Ref[String] = Ref("")

///| Whether this request actually reached — and passed — the acquire.
let scratch_priced : Ref[Bool] = Ref(false)

///| Tokens spent by this request.
let scratch_cost : Ref[UInt64] = Ref(0UL)

///| Tokens left in the bucket after this request's acquire.
let scratch_remaining : Ref[UInt64] = Ref(0UL)

// ---------------------------------------------------------------------------------------
// Bounds
// ---------------------------------------------------------------------------------------

///| Ceiling applied to a client-supplied `max_tokens`. The value arrives from an untrusted
/// body, and an astronomical one would wrap the u64 cost arithmetic back down to something
/// small — i.e. buy a free request. Clamping (rather than rejecting) keeps the failure
/// direction right: an absurd reservation prices absurdly and is denied by the bucket.
const MAX_TOKENS_CEILING : UInt64 = 100_000_000UL

///| Largest JSON number that still denotes an exact integer (2^53 - 1). A `max_tokens` past
/// it is not a token count the client can have meant — the JSON number that carried it could
/// not represent it exactly — so it is treated as absent rather than clamped, the same as any
/// other value that is not a non-negative integer.
const MAX_EXACT_JSON_INT : Double = 9_007_199_254_740_991.0

///| Longest `model` name this filter turns into a `model-cost-percent.<model>` lookup. The
/// name is untrusted body content, nothing plausible is longer, and the 100% fallback charges
/// MORE than any configured discount would — so declining to look up an implausible name is
/// the safe direction.
const MAX_MODEL_NAME_BYTES : Int = 128

///| Saturation point of the cost arithmetic.
const U64_MAX : UInt64 = 18_446_744_073_709_551_615UL

// ---------------------------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------------------------

///| ASCII-fold a header name for case-insensitive comparison. HTTP field names are
/// case-insensitive; the contract hands them over as written.
fn ascii_lower(s : String) -> String {
  let buf = StringBuilder::new()
  for c in s {
    if c >= 'A' && c <= 'Z' {
      buf.write_char((c.to_int() + 32).unsafe_to_char())
    } else {
      buf.write_char(c)
    }
  }
  buf.to_string()
}

///| Find a header by its already-lowercased name.
fn find_header(headers : Array[@types.Header], lower_name : String) -> @types.Header? {
  for h in headers {
    if ascii_lower(h.name) == lower_name {
      return Some(h)
    }
  }
  None
}

///| Header values and response bodies are BYTES on the contract (ADR 000071). Everything
/// this filter writes is ASCII, so one byte per UTF-16 code unit is exact — no encoder
/// needed, and no chance of a multi-byte surprise in a header value.
fn ascii(s : String) -> FixedArray[Byte] {
  let out = FixedArray::make(s.length(), b'\x00')
  for i in 0..<s.length() {
    out[i] = s[i].to_byte()
  }
  out
}

///| Decode a header value as UTF-8 text, or `None` if those bytes are not UTF-8 at all.
///
/// The rate-limit key crosses the boundary as a WIT `string`, which MUST be valid UTF-8 — an
/// arbitrary byte string cannot be lowered into one, and the data plane never traps on client
/// input. Only MALFORMED bytes are rejected: a perfectly good non-ASCII key (a UTF-8 tenant
/// name) is a key like any other, and refusing it would be a limitation, not a defence.
fn utf8_text(bytes : FixedArray[Byte]) -> String? {
  let raw = Bytes::makei(bytes.length(), i => bytes[i])
  try Some(@utf8.decode(raw[:])) catch {
    _ => None
  }
}

///| UTF-8 byte length of a MoonBit string.
///
/// MoonBit strings are UTF-16, and the cost formula is defined over UTF-8 BYTES — the unit
/// the payload was measured in on the wire. `String::length()` counts UTF-16 code units, so
/// it under-counts every non-Latin script and mis-counts every emoji; using it would let a
/// caller buy a long CJK prompt at a third of its real size. Walking code points and summing
/// their UTF-8 widths is exact and, unlike encoding the string, allocates nothing.
fn utf8_byte_len(s : String) -> Int {
  let mut n = 0
  for c in s {
    let cp = c.to_int()
    n = n +
      (if cp < 0x80 {
        1
      } else if cp < 0x800 {
        2
      } else if cp < 0x10000 {
        3
      } else {
        4
      })
  }
  n
}

///| Strict decimal parse. Base 10 is pinned deliberately: an auto-detecting parse would read
/// a config value of `0x10` as 16, and operator config should mean what it looks like.
fn parse_u64(raw : String) -> UInt64? {
  if raw.length() == 0 {
    return None
  }
  try Some(@string.parse_uint64(raw.view(), base=10)) catch {
    _ => None
  }
}

///| Read one JSON member, treating a non-object document as having no members at all.
fn field(doc : Json, name : String) -> Json? {
  match doc {
    Object(members) => members.get(name)
    _ => None
  }
}

///| `base * percent / 100`, saturating rather than wrapping. Wrapping here would turn an
/// expensive request into a cheap one, which is the one direction a limiter must never fail.
fn scale_percent(base : UInt64, percent : UInt64) -> UInt64 {
  if base == 0UL || percent == 0UL {
    return 0UL
  }
  if base > U64_MAX / percent {
    return U64_MAX
  }
  base * percent / 100UL
}

///| A filter-authored JSON error. `content-length` is deliberately absent: the host owns it
/// and rejects a guest-supplied one fail-closed (ADR 000071).
fn json_error(status : UInt, message : String) -> @types.HttpResponse {
  @types.HttpResponse::{
    status,
    headers: [
      @types.Header::{ name: "content-type", value: ascii("application/json") },
    ],
    body: ascii("{\"error\":\"" + message + "\"}"),
  }
}

///| Read an operator-supplied integer, or fail the LOAD.
///
/// A mis-typed number would otherwise silently price every request wrong for as long as the
/// filter runs — the quietest possible failure of a limiter. Trapping in `init` turns it into
/// a load-time error the operator sees immediately, which combined with
/// `isolation = "trusted"` surfaces as "this filter did not load" rather than as a production
/// mystery (ADR 000066).
fn config_u64(key : String, fallback : UInt64, minimum : UInt64) -> UInt64 {
  match @hostConfig.get(key) {
    None => fallback
    Some(raw) =>
      match parse_u64(raw) {
        Some(v) if v >= minimum => v
        _ => {
          @hostLog.log(
            @hostLog.ERROR,
            "filter-tokenlimit: config \{key}=\{raw} is not an integer >= \{minimum}",
          )
          panic()
        }
      }
  }
}

// ---------------------------------------------------------------------------------------
// Exports
// ---------------------------------------------------------------------------------------

///|
pub fn init_() -> Unit {
  cfg_key_header.val = match @hostConfig.get("key-header") {
    // Present but empty is a BROKEN configuration, not a strict one: an empty header name
    // matches nothing, so the filter would answer every request 401 forever. Fail the load
    // instead of failing the traffic (ADR 000066), same reasoning as the numeric keys below.
    Some("") => {
      @hostLog.log(
        @hostLog.ERROR,
        "filter-tokenlimit: config key-header must not be empty",
      )
      panic()
    }
    Some(v) => ascii_lower(v)
    None => "x-api-key"
  }
  cfg_max_tokens_default.val = config_u64("max-tokens-default", 1024UL, 0UL)
  // A divisor of zero is as broken as an unparseable one, so `minimum` is 1 rather than 0.
  cfg_chars_per_token.val = config_u64("chars-per-token", 4UL, 1UL)
  @hostLog.log(
    @hostLog.INFO,
    "filter-tokenlimit: key-header=\{cfg_key_header.val} max-tokens-default=\{cfg_max_tokens_default.val} chars-per-token=\{cfg_chars_per_token.val}",
  )
}

///|
pub fn on_request(req : @types.HttpRequest) -> @types.RequestDecision {
  // The scratch rule, first thing and unconditionally: nothing below may observe a previous
  // request's values, and no early return may skip this reset.
  scratch_key.val = ""
  scratch_priced.val = false
  scratch_cost.val = 0UL
  scratch_remaining.val = 0UL
  // Missing, empty and not-UTF-8 are all "no usable key" and get the SAME answer: telling a
  // prober which of the three it hit says something about the gate it does not need to know.
  let key = match find_header(req.headers, cfg_key_header.val) {
    Some(h) =>
      match utf8_text(h.value) {
        Some(s) => s
        None => ""
      }
    None => ""
  }
  if key == "" {
    // Fail closed. Without a key there is no bucket to spend from, so letting an unkeyed
    // request through would make it an unmetered one — the exact hole this filter exists to
    // close. Rejecting here also means the host never buffers a body it will not price.
    return @types.RequestDecision::ShortCircuit(json_error(401, "missing api key"))
  }
  scratch_key.val = key
  @types.RequestDecision::Continue
}

///|
pub fn on_request_body(body : FixedArray[Byte]) -> @types.RequestBodyDecision {
  let raw = Bytes::makei(body.length(), i => body[i])
  let text = try @utf8.decode(raw[:]) catch {
    _ =>
      return @types.RequestBodyDecision::ShortCircuit(
        json_error(400, "invalid json body"),
      )
  }
  let doc = try @json.parse(text.view()) catch {
    _ =>
      return @types.RequestBodyDecision::ShortCircuit(
        json_error(400, "invalid json body"),
      )
  }

  // A document that parses but is not an object simply carries none of the fields below and
  // prices as an empty prompt. This filter is a PRICE, not a schema check — rejecting shapes
  // it does not recognise would make it a de facto request validator for every route it sits
  // on, which is a different filter's job.
  let model = match field(doc, "model") {
    Some(String(m)) => m
    _ => ""
  }
  // Anything that is not a NON-NEGATIVE INTEGER — negative, fractional, NaN, or past the
  // exact-integer range of a JSON number — is treated as absent and priced at the operator's
  // default. Truncating `12.9` to 12 or clamping `-1` to 0 would both make a malformed value
  // CHEAPER than saying nothing at all, which is the one direction a limiter must not fail.
  // A genuine integer is clamped to the ceiling rather than rejected.
  let max_tokens = match field(doc, "max_tokens") {
    Some(Number(n, ..)) =>
      if n.is_nan() || n < 0.0 || n > MAX_EXACT_JSON_INT || n != n.to_uint64().to_double() {
        cfg_max_tokens_default.val
      } else if n.to_uint64() > MAX_TOKENS_CEILING {
        MAX_TOKENS_CEILING
      } else {
        n.to_uint64()
      }
    _ => cfg_max_tokens_default.val
  }

  // Input size is the UTF-8 byte length of the concatenation of `prompt` and every string
  // `messages[i].content`. The lengths are SUMMED rather than the strings concatenated: the
  // two are equal by definition, and summing keeps a megabyte payload from being copied a
  // second time on the hot path. Non-string contents (tool calls, image parts) are ignored —
  // they are not text and this estimator only prices text.
  let mut input_bytes = 0
  match field(doc, "prompt") {
    Some(String(p)) => input_bytes += utf8_byte_len(p)
    _ => ()
  }
  match field(doc, "messages") {
    Some(Array(messages)) =>
      for message in messages {
        match field(message, "content") {
          Some(String(c)) => input_bytes += utf8_byte_len(c)
          _ => ()
        }
      }
    _ => ()
  }
  let chars_per_token = cfg_chars_per_token.val
  // Ceiling division: a one-byte prompt still costs a token.
  let input_est = (input_bytes.to_uint64() + chars_per_token - 1UL) / chars_per_token
  let base = input_est + max_tokens

  // Per-model multiplier. The key is looked up rather than enumerated because `host-config`
  // is a point-query interface, and it is skipped entirely for an unnamed model (so an empty
  // string cannot collide with a configured entry) or an implausibly long one.
  let percent = if model == "" || utf8_byte_len(model) > MAX_MODEL_NAME_BYTES {
    100UL
  } else {
    match @hostConfig.get("model-cost-percent." + model) {
      None => 100UL
      Some(raw) =>
        match parse_u64(raw) {
          Some(p) => p
          // Same fail-closed reasoning as `config_u64`, one hook later: this key can only be
          // reached once a request names the model, so it cannot be validated in `init`.
          // Pricing it at the 100% default would silently undercharge exactly the model the
          // operator singled out as expensive.
          None => {
            @hostLog.log(
              @hostLog.ERROR,
              "filter-tokenlimit: config model-cost-percent.\{model}=\{raw} is not an integer",
            )
            panic()
          }
        }
    }
  }
  // At least one token per request: a free request is not a metered one.
  let scaled = scale_percent(base, percent)
  let cost = if scaled < 1UL { 1UL } else { scaled }
  let outcome = @hostRatelimit.try_acquire(scratch_key.val, cost)
  if !outcome.allowed {
    // `retry-after` is whole seconds on the wire, and the host's hint is milliseconds. Round
    // UP: truncating 1500ms to "1" advertises a retry that is still too early to succeed.
    let retry_after_s = (outcome.retry_after_ms + 999UL) / 1000UL
    return @types.RequestBodyDecision::ShortCircuit(@types.HttpResponse::{
      status: 429,
      headers: [
        @types.Header::{ name: "content-type", value: ascii("application/json") },
        @types.Header::{
          name: "retry-after",
          value: ascii(retry_after_s.to_string()),
        },
      ],
      body: ascii("{\"error\":\"token budget exhausted\"}"),
    })
  }
  scratch_cost.val = cost
  scratch_remaining.val = outcome.remaining
  scratch_priced.val = true
  // The BARE continue arm (0.4.0, ADR 000098): this filter inspects the body and never
  // rewrites it, so returning the bytes back across the boundary would charge every priced
  // request a full copy to say "unchanged".
  @types.RequestBodyDecision::Continue
}

///|
pub fn on_response(
  _req : @types.HttpRequest,
  _resp : @types.HttpResponse,
) -> @types.ResponseDecision {
  // Only a request that actually reached the acquire has numbers worth reporting; a 401 or a
  // 429 already said everything in its own body.
  if !scratch_priced.val {
    return @types.ResponseDecision::Continue
  }
  @types.ResponseDecision::Modified(@types.ResponseEdit::{
    set_status: None,
    set_headers: [
      @types.Header::{
        name: "x-tokenlimit-cost",
        value: ascii(scratch_cost.val.to_string()),
      },
      @types.Header::{
        name: "x-tokenlimit-remaining",
        value: ascii(scratch_remaining.val.to_string()),
      },
    ],
    remove_headers: [],
  })
}
